# ============================================================================
# Tu Pensión Inteligente - Back-office MVP
# Archivo de ejemplo de variables de entorno
# ============================================================================

# Aplicación
APP_ENV=development
APP_NAME=Tu Pensión Inteligente Back-office
APP_DEBUG=true

# ============================================================================
# PostgreSQL - Conexión a base de datos TPI (mismo repositorio de ingesta)
# ============================================================================

# Opción A: Variables individuales
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tpi_local
DATABASE_USER=tpi_app
DATABASE_PASSWORD=change_me
DATABASE_SCHEMA=tpi

# Opción B (alternativa): URL completa
# DATABASE_URL=postgresql+psycopg://tpi_app:change_me@localhost:5432/tpi_local

# ============================================================================
# Políticas y términos (versioning)
# ============================================================================

PRIVACY_POLICY_VERSION=demo-2026-01
TERMS_VERSION=demo-2026-01

# ============================================================================
# Logging
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=logs/backoffice.log

# ============================================================================
# Seguridad mínima (MVP local)
# ============================================================================

# Por defecto deshabilitado. Para MVP: establecer en true para ambiente demostrativo
ALLOW_DEMO_MODE=true

# ============================================================================
# Notas de configuración:
# ============================================================================
# 1. DATABASE_HOST: Usar "localhost" para conexión local, RDS endpoint para producción
# 2. DATABASE_PASSWORD: NUNCA incluir credenciales reales en Git. Usar secrets manager en prod.
# 3. APP_ENV: development, staging, production
# 4. LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
# 5. Para AWS: configurar RDS endpoint, credenciales en AWS Secrets Manager, SSL=True
