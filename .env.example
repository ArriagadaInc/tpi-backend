# ============================================================================
# Tu Pension Inteligente - Backoffice
# Example environment configuration
# ============================================================================

# Application
APP_ENV=local
APP_NAME=Tu Pension Inteligente Back-office
APP_DEBUG=false
DEV_DELETE_ENABLED=false
LEAD_NOTIFICATIONS_ENABLED=false
LEAD_NOTIFICATION_TOPIC_ARN=
AUTH_ENABLED=false
AUTH_MODE=simple-dev
# AUTH_USERS_JSON=<Secrets Manager injected JSON; never store plaintext passwords here>
# TPI_PUBLIC_SITE_URL=http://tpi.localhost:8080/  # local only; aws-dev uses HTTPS DEV domain

# Public HTTP API. API_IDEMPOTENCY_HMAC_SECRET must be injected securely in aws-dev;
# use a local-only value for development and tests, never commit a real key.
API_IDEMPOTENCY_HMAC_SECRET=
API_MAX_REQUEST_BYTES=16384
API_RATE_LIMIT_REQUESTS=5
API_RATE_LIMIT_WINDOW_SECONDS=600
API_TRUSTED_PROXY_CIDRS=

# ============================================================================
# Database precedence
# 1. DATABASE_URL, if defined
# 2. DATABASE_* discrete settings
# 3. Safe local defaults only when APP_ENV=local
# ============================================================================

# Optional complete URL.
# Preferred format for psycopg:
# DATABASE_URL=postgresql://tpi_app:change_me@localhost:5432/tpi_local?sslmode=disable

# Discrete connection settings
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tpi_local
DATABASE_USER=tpi_app
DATABASE_PASSWORD=change_me_local_only
DATABASE_SCHEMA=tpi
DATABASE_SSLMODE=disable
DATABASE_SSLROOTCERT=
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_TIMEOUT=30

# ============================================================================
# Policy versioning
# ============================================================================
PRIVACY_POLICY_VERSION=demo-2026-01
TERMS_VERSION=demo-2026-01

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/backoffice.log

# ============================================================================
# Security / demo mode
# ============================================================================
ALLOW_DEMO_MODE=false

# ============================================================================
# Example AWS development values (do not commit real secrets)
# ============================================================================
# APP_ENV=aws-dev
# DATABASE_HOST=<rds-endpoint>
# DATABASE_PORT=5432
# DATABASE_NAME=tpi
# DATABASE_USER=tpi_app
# DATABASE_PASSWORD=<inject-secret>
# DATABASE_SCHEMA=tpi
# DATABASE_SSLMODE=require
# DATABASE_SSLROOTCERT=
# DATABASE_CONNECT_TIMEOUT=10
# DATABASE_POOL_MIN_SIZE=1
# DATABASE_POOL_MAX_SIZE=5
# DATABASE_POOL_TIMEOUT=30
# LEAD_NOTIFICATIONS_ENABLED=true
# LEAD_NOTIFICATION_TOPIC_ARN=arn:aws:sns:<region>:<account-id>:<topic-name>

# ============================================================================
# Example production values (Secrets Manager or deployment secrets only)
# ============================================================================
# APP_ENV=production
# DATABASE_HOST=<private-rds-endpoint>
# DATABASE_PORT=5432
# DATABASE_NAME=tpi
# DATABASE_USER=tpi_app
# DATABASE_PASSWORD=<inject-secret>
# DATABASE_SCHEMA=tpi
# DATABASE_SSLMODE=verify-full
# DATABASE_SSLROOTCERT=/path/to/global-bundle.pem
# DATABASE_CONNECT_TIMEOUT=10
# DATABASE_POOL_MIN_SIZE=2
# DATABASE_POOL_MAX_SIZE=10
# DATABASE_POOL_TIMEOUT=30
