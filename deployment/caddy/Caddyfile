{$TPI_PUBLIC_DOMAIN:localhost} {
    log {
        output stdout
        format json
    }

    handle /api/* {
        reverse_proxy api:8000
    }

    handle {
        root * /srv/front
        header {
            Content-Security-Policy "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://mindicador.cl; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
            Referrer-Policy "strict-origin-when-cross-origin"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
        }
        file_server
    }
}

backoffice.{$TPI_PUBLIC_DOMAIN:localhost} {
    log {
        output stdout
        format json
    }

    reverse_proxy backoffice:8501
}
